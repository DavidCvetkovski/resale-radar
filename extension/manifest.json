{
  "manifest_version": 3,
  "name": "Resale Radar",
  "version": "1.0.9",
  "description": "Watches TicketSwap event pages at a random interval and rings your Mac, emails you and pushes to your phone when tickets are listed. Not affiliated with TicketSwap.",
  "key": "",
  "permissions": ["alarms", "notifications", "offscreen", "storage", "tabs", "scripting", "nativeMessaging"],
  "host_permissions": ["https://www.ticketswap.com/*", "https://www.ticketswap.nl/*", "https://ntfy.sh/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
